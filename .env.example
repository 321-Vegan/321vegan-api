ENV=local

POSTGRES_USER=vegan_user
POSTGRES_PASSWORD=vegan_pass
POSTGRES_HOST=321vegandb
POSTGRES_PORT=5432
POSTGRES_DB=vegan_db

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}

# SQLAlchemy connection pool sizing (keep POOL_SIZE + MAX_OVERFLOW comfortably
# below Postgres' max_connections, especially if running multiple API instances)
