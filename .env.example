DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

FRONTEND_URL=http://localhost:3000

PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin

